{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "korob",
  "version": "0.1.0",
  "identifier": "com.korob.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Korob",
        "width": 860,
        "height": 560,
        "minWidth": 540,
        "minHeight": 360,
        "decorations": false,
        "center": true,
        "resizable": true,
        "shadow": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
